{
  "name": "btfmt",
  "displayName": "btfmt - bpftrace Language Support",
  "description": "Format, complete, and navigate bpftrace scripts with a bundled language server.",
  "version": "0.3.2",
  "publisher": "fanyang89",
  "license": "Unlicense",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B1115",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanyang89/bpftrace-formatter.git"
  },
  "homepage": "https://github.com/fanyang89/bpftrace-formatter#readme",
  "bugs": {
    "url": "https://github.com/fanyang89/bpftrace-formatter/issues"
  },
  "qna": false,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "bpftrace",
    "ebpf",
    "bpf",
    "linux",
    "tracing",
    "formatter",
    "language-server",
    "lsp",
    "observability",
    "kernel"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:bpftrace",
    "onCommand:btfmt.restartLsp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Restricted Mode keeps current-document formatting, diagnostics, and static completion. Workspace indexing and system metadata access are disabled.",
      "restrictedConfigurations": [
        "btfmt.serverPath",
        "btfmt.configPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "btfmt requires a local or remote workspace filesystem to run its bundled native language server."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "btfmt.restartLsp",
        "title": "Restart Server",
        "category": "btfmt"
      },
      {
        "command": "btfmt.showLogs",
        "title": "Show Logs",
        "category": "btfmt"
      },
      {
        "command": "btfmt.openSettings",
        "title": "Open Settings",
        "category": "btfmt"
      }
    ],
    "grammars": [
      {
        "language": "bpftrace",
        "scopeName": "source.bpftrace",
        "path": "./syntaxes/bpftrace.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "bpftrace",
        "aliases": [
          "bpftrace"
        ],
        "extensions": [
          ".bt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "btfmt",
      "properties": {
        "btfmt.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Custom btfmt executable. Leave empty to use the bundled server, with PATH as a fallback."
        },
        "btfmt.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to .btfmt.json. Can be absolute or workspace-relative."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "test": "npm run compile && npm run test:compile && node ./out/test/runTest.js",
    "test:compile": "esbuild ./src/test/runTest.ts --bundle --outfile=out/test/runTest.js --platform=node --format=cjs && esbuild ./src/test/suite/index.ts --bundle --outfile=out/test/suite/index.js --external:vscode --platform=node --format=cjs",
    "typecheck": "tsc --noEmit",
    "watch": "npm run compile -- --watch",
    "vscode:prepublish": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.4.5"
  }
}
